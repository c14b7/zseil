# Konfiguracja aplikacji Plan Lekcji ZSEIL
# Skopiuj ten plik jako .env i dostosuj wartości do swoich potrzeb

# URL strony z planami lekcji
BASE_URL=http://dane.dane.pl/dane

# Ustawienia scrapowania
HEADLESS_MODE=true
SCRAPING_DELAY=1
TIMEOUT=15000

# Plik wyjściowy
OUTPUT_FILE=data.json

# Ustawienia logowania (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Opcjonalne ustawienia przeglądarki
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36